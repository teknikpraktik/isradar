{
  "name": "isradar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "data": "node scripts/build-region-data.mts",
    "prepare-assets": "node scripts/copy-maplibre-worker.mjs && node scripts/build-region-data.mts",
    "predev": "npm run prepare-assets",
    "dev": "next dev",
    "prebuild": "npm run prepare-assets",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test \"lib/**/*.test.mts\""
  },
  "dependencies": {
    "maplibre-gl": "^6.11.2",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "polygon-clipping": "^0.15.7",
    "typescript": "^5"
  },
  "engines": {
    "node": "24.x"
  }
}
